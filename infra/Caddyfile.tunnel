:80 {
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
    Permissions-Policy "camera=(), geolocation=(), microphone=()"
  }

  # The tunnel serves both hostnames. Only the private Content Room hostname
  # redirects its root; the public hostname opens the photography site.
  @adminRoot {
    host admin.nollestudios.com
    path /
  }
  redir @adminRoot /admin/ 308

  # Vite fingerprints everything under /assets/, so browsers keep it for a
  # year; the page shell revalidates so a release shows up at once.
  @hashed path /assets/*
  header @hashed Cache-Control "public, max-age=31536000, immutable"
  @shell path / /index.html /archive /archive/
  header @shell Cache-Control "no-cache"

  @cms path /api/* /admin /admin/* /media/photos/* /media/videos/*
  handle @cms {
    reverse_proxy cms:8787
  }

  handle /media/* {
    root * /srv
    file_server
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
