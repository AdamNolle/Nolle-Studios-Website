# Copy to .env for local development. Choose your own password.
CMS_ADMIN_PASSWORD=
CMS_PORT=8788
STORAGE_DRIVER=local
SQLITE_FILE=.local/cms.sqlite
LOCAL_MEDIA_DIR=.local/media
STAGING_DIR=.local/staging
MEDIA_BASE_URL=/media

# Alt-text drafts from a local vision model (npm run alt:model). Development
# defaults to http://127.0.0.1:8790; production leaves drafting off unless set.
# ALT_TEXT_URL=http://127.0.0.1:8790
# ALT_TEXT_AUTO=true      # draft in the background after uploads without alt text
# ALT_TEXT_MODEL=         # only needed when the server hosts several models

# Production: use CMS_ADMIN_PASSWORD_HASH from `npm run cms:hash` instead of the plain password.
# CMS_ADMIN_PASSWORD_HASH='scrypt$...'
# CMS_SESSION_SECRET=<at least 32 random bytes, encoded as hex>
# SITE_DOMAIN=nollestudios.com
# POSTGRES_PASSWORD=<unique database password>

# Production database: DATABASE_URL or the separate PG* values below.
# DATABASE_URL=postgresql://user:password@host:5432/database
# PGHOST=db
# PGPORT=5432
# PGUSER=nolle
# PGPASSWORD=<secret>
# PGDATABASE=nolle

# R2, B2, or another S3-compatible public media bucket. Keep credentials private.
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=nolle-public
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# MEDIA_BASE_URL=https://media.nollestudios.com
